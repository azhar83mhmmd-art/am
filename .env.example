# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# Supabase Dashboard > Project Settings > API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci "anon public" (aman dipakai di browser)
SUPABASE_ANON_KEY=isi_anon_key_di_sini
# Kunci "service_role" (RAHASIA - hanya dipakai di server.js, jangan dibagikan)
SUPABASE_SERVICE_KEY=isi_service_role_key_di_sini

# Opsional
# PORT=8112
# UPSTREAM=https://am.noxxyrorr.biz.id

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile > Add site)
TURNSTILE_SITE_KEY=isi_site_key_di_sini
# Rahasia, hanya dipakai di server.js
TURNSTILE_SECRET_KEY=isi_secret_key_di_sini

# Email di feed publik disamarkan sedikit (kenzo***@gmail.com). Default aktif; isi false untuk menampilkan penuh
# MASK_EMAIL=true

# ---- v4.3: Menu admin, chat & blokir perangkat ----
# Kata sandi menu /admin (WAJIB diisi agar /admin aktif, minimal 12 karakter, jangan dibagikan)
ADMIN_PASSWORD=isi_kata_sandi_admin_yang_panjang
# Rahasia penanda tangan token perangkat & sesi admin (acak, panjang). Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=isi_string_acak_panjang
# Blokir ketat: sidik jari perangkat yang sama tetap diblokir walau data browser dihapus & jaringan berganti (default true).
# Isi false jika HP dengan tipe yang sama ikut terblokir; sidik jari + IP tetap dicocokkan.
# BLOCK_FP_STRICT=true
# Blokir juga berdasarkan IP saja (bisa mengenai satu jaringan yang sama). Default false.
# BLOCK_IP=false
# Batas permintaan aktivasi (kirim link + verifikasi) per perangkat dalam 10 menit (per IP = 3x lipat)
# ACT_LIMIT=20

# ---- v4.8: Kunci premium (1 iklan = 1 kunci = 1 akun premium) ----
# Isi false untuk mematikan sistem kunci (semua orang bebas generate)
# KEYS_REQUIRED=true
# Lama iklan yang wajib ditonton (detik, 5-60)
# AD_SECONDS=15
# Kunci maksimal yang boleh ditabung per perangkat
# KEY_MAX=5
# Iklan maksimal per perangkat per 24 jam
# KEY_DAILY=30
# Halaman berisi iklan. Default /ads (file public/ads.html, tempel kode iklan di sana).
# Boleh diisi URL penuh dari domain lain, mis. https://iklanku.example.com/slot
# Alamat halaman iklan di domain terpisah (folder premify-ads di-deploy ke Vercel). Isi setelah deploy, contoh:
# AD_FRAME_URL=https://ads.kairoo.my.id/
# AD_FRAME_URL=/ads

# Izinkan kode iklan memakai penyimpanan browser di popup (dipakai jika iklan kosong di popup tapi tampil di /ads).
# Kurang aman: kode pihak ketiga jadi satu domain dengan panel. Lebih baik pakai AD_FRAME_URL ke domain terpisah.
# AD_SAME_ORIGIN=false

# ---- v4.8.2: Gerbang pemblokir iklan ----
# Tutup website bagi pengguna yang memblokir iklan (DNS/ekstensi). Isi false untuk mematikan
# AD_BLOCK_GATE=true
# Alamat yang dites untuk deteksi. Kosongkan = otomatis dari skrip pertama di public/ads.html
# AD_PROBE_URL=
